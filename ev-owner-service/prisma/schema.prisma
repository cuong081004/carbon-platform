generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  vehicleTrips VehicleTrip[]
  carbonCredits CarbonCredit[]
  carbonWallets CarbonWallet[]
  carbonMarketListings CarbonMarketListing[]
  bids            Bid[]
  priceSuggestionHistorys PriceSuggestionHistory[]
  paymentIntents PaymentIntent[]
}

enum Role {
  ADMIN
  USER
  VERIFIER
  BUYER
}

model VehicleTrip {
  id             Int      @id @default(autoincrement())
  owner          User     @relation(fields: [ownerId], references: [id])
  ownerId        Int
  startLocation  String
  endLocation    String
  distanceKm     Float
  energyUsedKWh  Float
  co2SavedKg     Float
  date           DateTime @default(now())
  carbonCredits CarbonCredit[]
}

model CarbonCredit {
  id             Int       @id @default(autoincrement())
  ownerId        Int
  tripId         Int
  creditsEarned  Float
  co2SavedKg     Float
  createdAt      DateTime  @default(now())

  owner          User        @relation(fields: [ownerId], references: [id])
  trip           VehicleTrip @relation(fields: [tripId], references: [id])
}

model CarbonWallet {
  id          Int       @id @default(autoincrement())
  ownerId     Int       @unique
  balance     Float     @default(0)
  balanceFiat    Float     @default(0)   // Số tiền (USD/VND)
  balanceCarbon  Float     @default(0)   // Số tín chỉ carbon
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  owner       User      @relation(fields: [ownerId], references: [id])
  transactions   CarbonWalletTransaction[]
}

model CarbonWalletTransaction {
  id             Int       @id @default(autoincrement())
  walletId       Int
  type           TransactionType
  amountFiat     Float     @default(0)
  amountCarbon   Float     @default(0)
  description    String?
  createdAt      DateTime  @default(now())

  wallet         CarbonWallet @relation(fields: [walletId], references: [id])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BUY_CARBON
  SELL_CARBON
  TRANSFER
}

model CarbonMarketListing {
  id            Int       @id @default(autoincrement())
  sellerId      Int
  buyerId       Int?
  type          String    // 'FIXED' | 'AUCTION'
  amount        Float     // số tín chỉ rao bán
  pricePerCredit Float    // giá 1 tín chỉ carbon
  status        String    @default("OPEN") // OPEN, SOLD, CANCELLED
  startTime     DateTime? // chỉ dùng cho auction
  endTime       DateTime? // chỉ dùng cho auction
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  seller        User      @relation(fields: [sellerId], references: [id])
  bids          Bid[]
}

model Bid {
  id         Int       @id @default(autoincrement())
  auctionId  Int
  bidderId   Int
  bidAmount  Float     // tổng giá trị bid
  createdAt  DateTime  @default(now())

  auction    CarbonMarketListing @relation(fields: [auctionId], references: [id])
  bidder     User                @relation(fields: [bidderId], references: [id])
}

model PriceSuggestionHistory {
  id              Int      @id @default(autoincrement())
  userId          Int
  suggestedPrice  Float
  trend           String
  avgMarket       Float
  avgUserCo2      Float
  slope           Float
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
}

model PaymentIntent {
  id             Int      @id @default(autoincrement())
  externalId     String   @unique    // id do gateway trả về (mock)
  userId         Int
  amountFiat     Float
  currency       String   @default("USD")
  status         String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  metadata       Json?    // lưu context, ví dụ { type: "DEPOSIT" | "BUY", listingId: 12 }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
}
